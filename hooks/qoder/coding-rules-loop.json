{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|run_in_terminal|Write|Edit|search_replace|create_file|write_file|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|run_in_terminal|Write|Edit|search_replace|create_file|write_file|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Bash|run_in_terminal|Write|Edit|search_replace|create_file|write_file|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "CODING_RULES_LOOP_MODE=observe /usr/bin/python3 ~/.qoder/skills/coding-rules-loop/scripts/qoder_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
